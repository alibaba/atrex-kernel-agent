    },
    {
      "id": "candidate",
      "name": "aka.task.candidate_workspace.plugin",
      "required": true
    },
    {
      "id": "agent",
      "name": "aka.legacy.workflow.agent_plugin",
      "required": true
    },
    {
      "id": "evaluation",
      "name": "aka.evaluation.plugin",
      "required": true
    },
    {
      "id": "canonical-reader",
      "name": "aka.legacy.workflow.canonical_reader_plugin",
      "required": true
    },
    {
      "id": "experiment",
      "name": "aka.experiment.plugin",
      "required": true
    },
    {
      "id": "workflow-observer",
      "name": "aka.legacy.workflow.observer",
