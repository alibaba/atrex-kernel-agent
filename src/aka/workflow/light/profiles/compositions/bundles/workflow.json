{
  "api_version": 1,
  "entries": [
    {
      "id": "execution",
      "name": "aka.execution.plugin",
      "required": true,
      "config": {
        "profile": "remote"
      }
    },
    {
      "id": "resources",
      "name": "aka.resources.plugin",
      "required": true,
      "config": {
        "plugins": [
          "${aka:repo_root}/plugins/gpu-wiki"
        ],
        "bundles": [
          "measurement-session",
          "research-records"
        ]
      }
    },
    {
      "id": "problem",
      "name": "aka.task.problem.plugin",
      "required": true,
      "config": {
        "worker_requirements": "${env:ATREX_SANDBOX_REQUIREMENTS_FILE}"
      }
    },
    {
      "id": "source",
      "name": "aka.task.source.plugin",
      "required": true
    },
    {
      "id": "candidate",
      "name": "aka.task.candidate_workspace.plugin",
      "required": true
    },
    {
      "id": "agent",
      "name": "aka.agent.plugin",
      "required": true
    },
    {
      "id": "evaluation",
      "name": "aka.evaluation.plugin",
      "required": true,
      "config": {
        "shape_batch_size": 10,
        "comparison_method": "native-abba",
        "measurement_repetitions": 1
      }
    },
    {
      "id": "experiment",
      "name": "aka.experiment.plugin",
      "required": true
    },
    {
      "id": "workflow-observer",
      "name": "aka.workflow.light.observer",
      "required": true
    },
    {
      "id": "workflow",
      "name": "aka.workflow.light.plugin",
      "required": true,
      "config": {
        "startup": true
      }
    }
  ]
}
