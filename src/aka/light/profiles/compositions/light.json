{
  "api_version": 1,
  "bundles": [
    "aka.legacy.workflow:profiles/compositions/bundles/workflow.json",
    "light-services"
  ],
  "patches": [
    {
      "id": "agent",
      "remove": true
    },
    {
      "id": "agent",
      "insert": {
        "name": "aka.light.agent.plugin",
        "required": true,
        "config": {
          "sandbox": "none",
          "capture": true
        }
      }
    },
    {
      "id": "candidate",
      "remove": true
    },
    {
      "id": "candidate",
      "insert": {
        "name": "aka.light.workspace.plugin",
        "required": true
      }
    },
    {
      "id": "workflow",
      "remove": true
    },
    {
      "id": "workflow",
      "insert": {
        "name": "aka.light.workflow.plugin",
        "required": true,
        "config": {
          "startup": true
        }
      }
    }
  ]
}
