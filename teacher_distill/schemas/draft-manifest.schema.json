{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atrex.local/schemas/teacher-draft-manifest-v1.json",
  "title": "Teacher distillation draft manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_level", "documents"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_level": {
      "enum": ["single-campaign", "reproduced", "cross-shape", "cross-operator"]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    }
  }
}
