// Render: dot -Tpng -Gdpi=180 assets/atrex-architecture-current.dot -o assets/atrex-architecture-current.png
digraph AtrexWorkflow {
  graph [
    rankdir=TB,
    bgcolor="#fffdf8",
    pad=0.28,
    nodesep=0.38,
    ranksep=0.48,
    splines=polyline,
    fontname="Helvetica",
    fontsize=22,
    fontcolor="#17263c",
    labelloc=t,
    label="Atrex Kernel Agent · v0.3.0 workflow"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#54708f",
    penwidth=1.5,
    fillcolor="#edf4ff",
    fontname="Helvetica",
    fontcolor="#17263c",
    fontsize=15,
    margin="0.23,0.16"
  ];
  edge [color="#52657c", penwidth=1.5, arrowsize=0.75, fontname="Helvetica", fontsize=12];

  input [label=<<B>Operator + run configuration</B><BR/>SOL-ExecBench or Atrex-Bench · target GPU · mode>];
  route [label=<<B>Orchestrator</B><BR/>One CLI · framework dispatch · budgets · production policy>];
  baseline [label=<<B>Establish baselines</B><BR/>V0: immutable reference · V1: framework kernel when enabled>];
  episode [fillcolor="#fff0cc", color="#b4863c",
    label=<<B>Isolated optimization episode</B><BR/>Coding agent + journal + Git worktree<BR/>Fast: five trials · Full: profile and iterate · Goal: broader roadmap>];
  verify [fillcolor="#e7f4ef", color="#4d8572",
    label=<<B>Supervisor-owned verification</B><BR/>Immutable full-workload evaluator<BR/>Production: policy review + numerical probes<BR/>Fast: score comparison · Full / Goal: same-allocation ABBA>];
  decision [shape=diamond, fillcolor="#fff5dd", color="#ad8340", margin="0.18,0.12",
    label=<<B>Strict passing<BR/>improvement?</B>>];
  promote [fillcolor="#dff1e6", color="#4d9068",
    label=<<B>Promote</B><BR/>Squash-commit kernel + manifest>];
  retain [fillcolor="#f1f3f7", color="#8390a1",
    label=<<B>Retain incumbent</B><BR/>Record failed or non-improving attempt>];
  output [fillcolor="#e4edff", color="#587caf",
    label=<<B>Canonical output</B><BR/>Best kernel · memory and evidence · SOL submission>];

  plugin [shape=box, style="rounded,filled,dashed", fillcolor="#faf7ed", color="#b49b72",
    fontsize=13, label=<<B>Knowledge + reviewers</B><BR/>GPU Wiki plugin, references,<BR/>optional Codex / Qoder reviews>];
  sandbox [shape=box, style="rounded,filled,dashed", fillcolor="#f1f8f6", color="#7daca0",
    fontsize=13, label=<<B>GPU sandbox</B><BR/>Local / gateway / isolated SSH<BR/>Outage recovery preserves work>];
  state [shape=box, style="rounded,filled,dashed", fillcolor="#f3f6fb", color="#92a6bf",
    fontsize=13, label=<<B>Durable state</B><BR/>Git · journal · memory<BR/>telemetry · restart state>];

  input -> route -> baseline -> episode -> verify -> decision;
  decision -> promote [label="yes"];
  decision -> retain [label="no"];
  promote -> output;
  retain -> output;
  output -> episode [label="budget remains", color="#b4863c", fontcolor="#9a7338",
    style=dashed, constraint=false, minlen=2];

  {rank=same; episode; plugin;}
  {rank=same; verify; sandbox;}
  {rank=same; output; state;}
  episode -> plugin [style=invis, weight=6];
  verify -> sandbox [style=invis, weight=6];
  output -> state [style=invis, weight=6];
  plugin -> episode [style=dashed, color="#b49b72", constraint=false];
  sandbox -> verify [style=dashed, color="#7daca0", constraint=false];
  state -> output [style=dashed, color="#92a6bf", constraint=false];
}
